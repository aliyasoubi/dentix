{
  "name": "dentix",
  "private": true,
  "version": "0.5.0",
  "description": "Dentix — Farsi-first single-office dental PMS (monorepo root)",
  "engines": {
    "node": ">=22.22.3 <23",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prelint": "npm run build --workspace @dentix/kernel",
    "lint": "npm run lint --workspaces --if-present",
    "lint:arch": "npm run lint:arch --workspace apps/api && npm run lint:arch --workspace apps/worker",
    "pretest": "npm run build --workspace @dentix/kernel",
    "test": "npm run test --workspaces --if-present",
    "pretest:int": "npm run build --workspace @dentix/kernel",
    "test:int": "npm run test:int --workspaces --if-present",
    "pretest:api": "npm run build --workspace @dentix/kernel",
    "test:api": "npm run test:api --workspace apps/api --if-present",
    "test:e2e": "npm run test:e2e --workspace apps/web --if-present",
    "openapi:check": "npm run openapi:check --workspace apps/api --if-present",
    "db:migrate": "npm run db:migrate --workspace apps/api",
    "db:migrate:down": "npm run db:migrate:down --workspace apps/api",
    "prebuild": "npm run build --workspace @dentix/kernel",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "10.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "prettier": "3.9.6"
  }
}
