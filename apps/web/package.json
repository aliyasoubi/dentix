{
  "name": "@dentix/web",
  "version": "0.5.0",
  "description": "Dentix web — Angular 22 + Material/CDK, Farsi-only RTL shell (ADR-012)",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run build --workspace @dentix/kernel",
    "start": "ng serve",
    "prebuild": "npm run build --workspace @dentix/kernel",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run build --workspace @dentix/kernel",
    "test": "ng test",
    "test:e2e": "playwright test",
    "lint": "ng lint",
    "lint:arch": "depcruise src --config .dependency-cruiser.json",
    "storybook": "ng run web:storybook",
    "build-storybook": "ng run web:build-storybook",
    "openapi:generate": "openapi-typescript ../api/openapi.json -o src/app/core/http/api-types.gen.ts",
    "openapi:check": "npm run openapi:generate && test -z \"$(git status --porcelain -- src/app/core/http/api-types.gen.ts)\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.1.0",
    "@angular/cdk": "22.1.0",
    "@angular/common": "22.1.0",
    "@angular/compiler": "22.1.0",
    "@angular/core": "22.1.0",
    "@angular/forms": "22.1.0",
    "@angular/material": "22.1.0",
    "@angular/platform-browser": "22.1.0",
    "@angular/router": "22.1.0",
    "date-fns-jalali": "4.4.0-0",
    "rxjs": "7.8.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.6.4",
    "@angular-devkit/architect": "0.2201.0",
    "@angular-devkit/build-angular": "22.1.0",
    "@angular-devkit/core": "22.1.0",
    "@angular-eslint/builder": "22.1.0",
    "@angular/build": "22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/compiler-cli": "22.1.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/angular-vite": "10.5.7",
    "@types/node": "20.19.43",
    "angular-eslint": "22.1.0",
    "dependency-cruiser": "18.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-storybook": "10.5.7",
    "jsdom": "28.1.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "storybook": "10.5.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vazirmatn": "33.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
