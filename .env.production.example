# Copy to .env.production for the docker-compose.prod.yml stack:
#   cp .env.production.example .env.production
#
# .env.production is gitignored. Never commit real secrets.
#
# The local rehearsal and the VPS use the same compose file and the same
# variables — only these values differ. On the VPS, set the two domains to
# real DNS names pointing at the host and Caddy obtains Let's Encrypt
# certificates automatically; the *.localhost defaults below resolve to
# 127.0.0.1 in current browsers with no /etc/hosts editing and get a
# certificate from Caddy's own internal CA instead.

# --- public hostnames -------------------------------------------------
DENTIX_APP_DOMAIN=dentix.localhost
DENTIX_AUTH_DOMAIN=auth.dentix.localhost
# Only used when the domains are public (Let's Encrypt account contact).
ACME_EMAIL=ops@example.invalid

# Ports Caddy publishes. 80/443 need privileges on some hosts; the
# rehearsal can use 8080/8443 if something already owns them locally.
HTTP_PORT=80
HTTPS_PORT=443

# --- database ---------------------------------------------------------
POSTGRES_DB=dentix
POSTGRES_USER=dentix
# CHANGE THIS. Generate one: openssl rand -base64 24
POSTGRES_PASSWORD=change_me_before_any_real_deployment
# Loopback-only host port so the office/user bootstrap script can reach the
# database during the local rehearsal. Remove the ports block from
# docker-compose.prod.yml entirely on the VPS.
POSTGRES_HOST_PORT=5434

# --- application ------------------------------------------------------
# 32 random bytes, base64url. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_ENCRYPTION_KEY=

# --- identity provider ------------------------------------------------
KEYCLOAK_ADMIN=admin
# CHANGE THIS. Generate one: openssl rand -base64 24
KEYCLOAK_ADMIN_PASSWORD=change_me_before_any_real_deployment

OIDC_CLIENT_ID=dentix-bff
# Keycloak regenerates this on every realm import and it is deliberately not
# in keycloak/dentix-realm.json (never commit a secret). Fetch it after the
# first `up` with:
#   ./ops/local/fetch-client-secret.sh
OIDC_CLIENT_SECRET=

# Image tag for the built API image. Bump for a real release so a rollback
# has something to roll back to (06-operations/04-release-process.md).
DENTIX_IMAGE_TAG=local
