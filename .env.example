# Copy to .env for local development. .env is gitignored — never commit real
# secrets here. Dev-only defaults match docker-compose.yml.

POSTGRES_DB=dentix
POSTGRES_USER=dentix
POSTGRES_PASSWORD=dentix_dev_only
# 5433, not 5432: this office already runs a separate Postgres container
# (the standalone inventory system, see CLAUDE.md) on the default port.
POSTGRES_PORT=5433

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_only
KEYCLOAK_PORT=8080

# The dentix-bff client's own secret — not in keycloak/dentix-realm.json
# (never commit a secret; Keycloak regenerates it on every realm import).
# Fetch it after `docker compose up -d keycloak`: see keycloak/README.md.
OIDC_CLIENT_SECRET=

# 32 random bytes, base64url. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_ENCRYPTION_KEY=

OIDC_ISSUER_URL=http://localhost:8080/realms/dentix
OIDC_CLIENT_ID=dentix-bff
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
APP_BASE_URL=http://localhost:3000
PORT=3000

# Mounts the browsable Swagger UI at /api/docs. Opt-in on purpose and
# deliberately fail-closed: leave it unset anywhere the API is reachable
# from outside the dev machine.
ENABLE_API_DOCS=true

# Number of reverse-proxy hops in front of this process (0 = none, the safe
# default). Set to 1 once ADR-010's nginx/Caddy is in front, or rate limiting
# buckets the whole office under the proxy's IP. Do NOT set it when nothing is
# actually in front — X-Forwarded-For becomes caller-controlled.
TRUST_PROXY_HOPS=0

# S3-compatible dev object storage (ADR-009), dev-only credentials.
MINIO_ROOT_USER=dentix
MINIO_ROOT_PASSWORD=dentix_dev_only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=dentix-documents-dev
